#!/usr/bin/env bash
# Enforces Conventional Commits (https://www.conventionalcommits.org).
# Enabled via: git config core.hooksPath .githooks
#
# This hook is a fast local signal only. The authoritative check is the
# commit-lint job in .github/workflows/ci.yaml, which does not depend on
# every contributor having hooks configured.

set -euo pipefail

hook_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=lib/conventional-pattern.sh
source "$hook_dir/lib/conventional-pattern.sh"

commit_msg_file="$1"
subject_line=$(head -n1 "$commit_msg_file")

conventional_check_subject "$subject_line" "Commit message"
